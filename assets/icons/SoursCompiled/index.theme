[Icon Theme]
Name=SoursCompiled
Comment=A Cyberpunk Violet Glow theme.
Inherits=breeze-dark,adwaita-dark,breeze,ubuntu-mono,yaru,Mint-X,elementary,hicolor


# Directory list
Directories=actions/16,status/arrows,status/22,actions/scalable,places/16,places/22,places/24,places/48,devices/scalable,apps/scalable,mimetypes/scalable,emblems/scalable,preferences/scalable,categories/scalable
ScaledDirectories=places/16@2x,places/16@3x,places/22@2x,places/22@3x,places/24@2x,places/24@3x
Example=folder
DisplayDepth=32

FollowsColorScheme=true

DesktopDefault=48
DesktopSizes=16,22,32,48,64,128,256
ToolbarDefault=22
ToolbarSizes=16,22,32,48
MainToolbarDefault=22
MainToolbarSizes=16,22,32,48
SmallDefault=16
SmallSizes=16,22,32,48
PanelDefault=48
PanelSizes=16,22,32,48,64,128,256
DialogDefault=32
DialogSizes=16,22,32,48,64,128,256

KDE-Extensions=.svg

[devices/scalable]
Context=Devices
Size=64
MinSize=8
MaxSize=192
Type=Scalable

[actions/scalable]
Context=Actions
Size=22
MinSize=16
MaxSize=192
Type=Scalable

#16x16 - Fixed size - Plasma theme - Monochrome volume badges in dock
[actions/16]
Size=16
Context=Actions
Type=Fixed

[apps/scalable]
Size=96
Context=Applications
MinSize=8
MaxSize=512
Type=Scalable

[mimetypes/scalable]
Context=MimeTypes
Size=96
MinSize=32
MaxSize=512
Type=Scalable

[places/16]
Size=16
Context=Places
Type=Fixed

[places/16@2x]
Size=16
Scale=2
Context=Places
Type=Fixed

[places/16@3x]
Size=16
Scale=3
Context=Places
Type=Fixed

[places/22]
Size=22
Context=Places
Type=Fixed

[places/22@2x]
Size=22
Scale=2
Context=Places
Type=Fixed

[places/22@3x]
Size=22
Scale=3
Context=Places
Type=Fixed

[places/24]
Size=24
Context=Places
Type=Fixed

[places/24@2x]
Size=24
Scale=2
Context=Places
Type=Fixed

[places/24@3x]
Size=24
Scale=3
Context=Places
Type=Fixed

[places/48]
Size=48
Context=Places
MinSize=32
MaxSize=512
Type=Scalable

# Tray Arrows
[status/arrows]
Context=Status
Size=22
MinSize=16
MaxSize=512
Type=Scalable

#22x22 - Plasma theme/System Tray
[status/22]
Size=22
MinSize=8
MaxSize=512
Context=Status
Type=Scalable

[emblems/scalable]
Context=Emblems
Size=64
MinSize=8
MaxSize=512
